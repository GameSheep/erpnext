{
  "name": "desk2",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "ERPNext Desk v2 — Ant Design Pro style frontend built on the Frappe REST API",
  "scripts": {
    "dev": "vite",
    "build": "vite build --base=/assets/erpnext/desk2/ && pnpm copy-html-entry",
