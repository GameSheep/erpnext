    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/charts": "^2.2.7",
    "@ant-design/icons": "^5.6.1",
    "@ant-design/pro-components": "^2.8.7",
    "@monaco-editor/react": "^4.6.0",
    "@types/leaflet": "^1.9.12",
    "antd": "^5.25.3",
    "dayjs": "^1.11.13",
    "frappe-react-sdk": "^1.17.0",
    "jotai": "^2.12.3",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hotkeys-hook": "^4.6.1",
    "react-leaflet": "^4.2.1",
    "react-quill": "^2.0.0",
    "react-router": "^7.6.1",
    "swr": "^2.3.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^18.3.22",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.27.0",
